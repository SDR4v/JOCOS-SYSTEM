// JOCOS Attendance & Payroll System — data model
// See C:\Users\rgnac\.claude\plans\lazy-marinating-kay.md for the full design context.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Auth / roster ──────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role
  employeeId   String?  @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime @default(now())

  editedAttendanceDays AttendanceDay[]        @relation("AttendanceDayEditor")
  requestedLeaves      WellnessLeaveRequest[] @relation("LeaveRequester")
  cancelledLeaves      WellnessLeaveRequest[] @relation("LeaveCanceller")
  confirmedTakenLeaves WellnessLeaveRequest[] @relation("LeaveTakenConfirmer")
  deletedLeaves        WellnessLeaveRequest[] @relation("LeaveDeleter")
  deletedEmployees     Employee[]             @relation("EmployeeDeleter")
  enteredTripAuths     TripAuthorization[]    @relation("TripAuthEnteredBy")
  biometricUploads     BiometricUpload[]      @relation("BiometricUploader")
  ignoredBiometricNames IgnoredBiometricName[] @relation("BiometricNameIgnorer")
  reviewedDtrRequests  DtrEntryRequest[]      @relation("DtrRequestReviewer")
  createdHolidays      Holiday[]              @relation("HolidayCreator")
  auditLogEntries      AuditLog[]             @relation("AuditActor")
  notifications        Notification[]         @relation("NotificationRecipient")
  avatar               UserAvatar?
}

// Kept in its own table (like BiometricUpload) rather than columns on User —
// so an ordinary user lookup never drags along an image blob.
model UserAvatar {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  mimeType  String
  fileData  Bytes
  updatedAt DateTime @updatedAt
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

// Work schedule the DTR is graded against. STANDARD = the default 8-12 &
// 1-5 office hours, every day. CUSTOM = the employee's own hours
// (session1*, plus optional session2* — night shifts, split/irregular
// shifts, or a single continuous session with no lunch break when
// session2 is left unset), the SAME every day. PER_DAY = hours that vary
// by day of week (see EmployeeDaySchedule) — e.g. different on Monday
// than Tuesday, or off entirely on some days. Minutes are
// minutes-since-midnight (0-1439); a session may cross midnight
// (end < start).
enum ScheduleMode {
  STANDARD
  CUSTOM
  PER_DAY
}

model Employee {
  id               String         @id @default(cuid())
  employeeNo       String         @unique
  officeAssignment String
  name             String
  positionTitle    String
  salaryGrade      Int
  status           EmployeeStatus @default(ACTIVE)
  scheduleMode     ScheduleMode   @default(STANDARD)
  session1Start    Int?
  session1End      Int?
  session2Start    Int?
  session2End      Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Soft delete — removes the employee from the roster view without
  // touching their DTR/payroll/leave history (which other records still
  // reference). Restoring only clears this; it doesn't re-apply ACTIVE
  // status, matching the same restore convention as WellnessLeaveRequest.
  deletedById String?
  deletedBy   User?     @relation("EmployeeDeleter", fields: [deletedById], references: [id])
  deletedAt   DateTime?

  user                  User?
  attendanceDays        AttendanceDay[]
  punchRecords          PunchRecord[]
  wellnessLeaveBalances WellnessLeaveBalance[]
  wellnessLeaveRequests WellnessLeaveRequest[]
  tripAuthorizations    TripAuthorization[]
  dtrEntryRequests      DtrEntryRequest[]
  daySchedules          EmployeeDaySchedule[]

  @@index([officeAssignment])
  @@index([status])
}

// One row per configured weekday, used only when Employee.scheduleMode
// is PER_DAY. dayOfWeek: 0 = Sunday ... 6 = Saturday. A weekday with no
// row (or with session1Start/End left null) falls back to the standard
// 8-12 & 1-5 hours for that day. session2 absent = single continuous
// session (no lunch break) for that day.
model EmployeeDaySchedule {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  dayOfWeek     Int
  session1Start Int?
  session1End   Int?
  session2Start Int?
  session2End   Int?

  @@unique([employeeId, dayOfWeek])
}

// ── Salary Grade rate table (page 1 of the source sheet) ───────

model SalaryGradeRate {
  id            String @id @default(cuid())
  year          Int
  salaryGrade   Int
  monthlyAmount Float

  @@unique([year, salaryGrade])
}

// ── DTR (Daily Time Record) ─────────────────────────────────────

enum AttendanceCode {
  PRESENT           // "0" — full day, no undertime
  LATE              // present, but late/undertime minutes logged
  ABSENT            // "A" — 0 credit
  UNDERTIME_HALF    // "U" — present AM only, 0.5 credit
  TARDY_HALF        // "T" — present PM only, 0.5 credit
  REST_DAY          // "X" — excluded, not counted, unpaid
  WORK_SUSPENDED    // "WS" — full credit, no deduction
  WELLNESS_LEAVE    // "WL" — full credit, paid, draws down WL balance
  TRIP_AUTHORIZATION // "TA" — credit computed from HR-entered time
  HOLIDAY           // "H" — no work, no pay; written by the holidays calendar
  UNSET             // no data yet — needs manual entry or biometrics review
}

enum AttendanceSource {
  BIOMETRIC
  WELLNESS_LEAVE
  TRIP_AUTHORIZATION
  HOLIDAY
  MANUAL
  EMPLOYEE_REQUEST // self-submitted by the COS worker, approved by HR
}

// A day's entry is driven by CS Form No. 48 (Daily Time Record): four punch
// times (AM/PM arrival & departure). The JOCOS code/dayCredit/lateMinutes are
// DERIVED from those times (see lib/dtr-time.ts), except for the manual
// overrides (REST_DAY, WORK_SUSPENDED, UNSET) that can't come from a punch,
// and WELLNESS_LEAVE/TRIP_AUTHORIZATION which are written by their own
// approval flows. Today the times are entered by hand; once RFID/biometric
// capture lands it fills the same four fields.
model AttendanceDay {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  date        DateTime
  code        AttendanceCode   @default(UNSET)
  lateMinutes Int              @default(0)
  dayCredit   Float            @default(0)
  source      AttendanceSource @default(MANUAL)
  amArrival   DateTime?
  // Auto-detected, never user-set: this day's AM Arrival is really the tail
  // of the PREVIOUS day's overnight shift (that day has an arrival but no
  // departure yet; this day has a departure but no arrival). The two rows'
  // times are combined into one shift graded on the previous day — see
  // lib/dtr-time.ts's detectNightShiftContinuation — and this flag just
  // tells the printed DTR to show "From Duty" here instead of blank.
  amArrivalFromDuty Boolean @default(false)
  amDeparture DateTime?
  pmArrival   DateTime?
  pmDeparture DateTime?

  editedById String?
  editedBy   User?    @relation("AttendanceDayEditor", fields: [editedById], references: [id])
  editedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
  @@index([date])
}

// ── Employee self-submitted DTR entries (pending HR review) ────

enum DtrEntryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model DtrEntryRequest {
  id          String                @id @default(cuid())
  employeeId  String
  employee    Employee              @relation(fields: [employeeId], references: [id])
  date        DateTime
  amArrival   DateTime?
  amDeparture DateTime?
  pmArrival   DateTime?
  pmDeparture DateTime?
  overrideCode AttendanceCode?      // set only for REST_DAY / WORK_SUSPENDED / UNSET proposals
  status      DtrEntryRequestStatus @default(PENDING)
  submittedAt DateTime              @default(now())

  reviewedById String?
  reviewedBy   User?     @relation("DtrRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  @@unique([employeeId, date])
  @@index([status])
}

// ── Wellness Leave (COS only) ───────────────────────────────────

model WellnessLeaveBalance {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  year       Int
  semester   Int // 1 = Jan-Jun (3 days), 2 = Jul-Dec (2 days)
  allotted   Int
  used       Int @default(0)

  @@unique([employeeId, year, semester])
}

// No admin approval gate — a request takes effect immediately on filing
// (balance drawn down, attendance days marked WELLNESS_LEAVE). ACTIVE vs.
// already-taken is derived from today's date vs. endDate at display time;
// CANCELLED means the employee pulled it back out before it happened.
enum LeaveRequestStatus {
  ACTIVE
  CANCELLED
}

model WellnessLeaveRequest {
  id          String              @id @default(cuid())
  employeeId  String
  employee    Employee            @relation(fields: [employeeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  daysCount   Int
  status      LeaveRequestStatus  @default(ACTIVE)
  notes       String?

  requestedById String
  requestedBy   User   @relation("LeaveRequester", fields: [requestedById], references: [id])

  cancelledById String?
  cancelledBy   User?    @relation("LeaveCanceller", fields: [cancelledById], references: [id])
  cancelledAt   DateTime?

  // Set when an admin has physically received the employee's paper
  // application and confirms the leave was taken — locks the display
  // status to TAKEN early (ahead of endDate) and blocks a pull-out.
  confirmedTakenById String?
  confirmedTakenBy   User?     @relation("LeaveTakenConfirmer", fields: [confirmedTakenById], references: [id])
  confirmedTakenAt   DateTime?

  // Soft delete — an admin-only cleanup action (e.g. a duplicate/erroneous
  // filing). Deleting a still-ACTIVE request also reverts its balance and
  // attendance-day effects (same as a pull-out) before hiding it; deleting
  // an already-CANCELLED one just hides it. Restoring only clears this —
  // it does NOT re-apply balance/attendance effects, to avoid double-booking.
  deletedById String?
  deletedBy   User?     @relation("LeaveDeleter", fields: [deletedById], references: [id])
  deletedAt   DateTime?

  createdAt DateTime @default(now())
}

// ── Trip Authorization ──────────────────────────────────────────

model TripAuthorization {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  date           DateTime
  timeIn         DateTime?
  timeOut        DateTime?
  referenceNo    String?
  attachmentPath String?

  enteredById String
  enteredBy   User   @relation("TripAuthEnteredBy", fields: [enteredById], references: [id])
  createdAt   DateTime @default(now())

  @@index([employeeId, date])
}

// ── Holidays / calendar ──────────────────────────────────────────
// Adding one here writes AttendanceCode.HOLIDAY into every active employee's
// AttendanceDay for that date via syncHolidayAttendance (0 credit — no work,
// no pay), so DTR and the JOCOS report both reflect it immediately.

enum HolidayType {
  REGULAR
  SPECIAL_NON_WORKING
}

model Holiday {
  id     String      @id @default(cuid())
  date   DateTime    @unique
  name   String
  type   HolidayType @default(REGULAR)

  createdById String
  createdBy   User   @relation("HolidayCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

// ── Biometrics upload bin ───────────────────────────────────────
// No RFID feed yet, and the biometrics machine (a separate system) isn't
// consistently exporting complete time-in/time-out data — so instead of
// auto-parsing punches, this is just a shared PDF library: HR uploads the
// biometrics export, employees open/download it to copy their own times
// into My DTR by hand. PunchRecord (below) stays ready for when automatic
// parsing is worth building.

enum BiometricUploadStatus {
  UPLOADED
  PROCESSED
  REVIEWED
}

model BiometricUpload {
  id          String   @id @default(cuid())
  title       String
  filename    String
  mimeType    String
  fileSize    Int
  fileData    Bytes
  periodStart DateTime?
  periodEnd   DateTime?
  status      BiometricUploadStatus @default(UPLOADED)

  uploadedById String
  uploadedBy   User   @relation("BiometricUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  punchRecords PunchRecord[]
}

model PunchRecord {
  id                String   @id @default(cuid())
  biometricUploadId String
  biometricUpload   BiometricUpload @relation(fields: [biometricUploadId], references: [id])

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  rawDept      String?
  rawName      String
  rawNo        String?
  timestamp    DateTime
  isDuplicate  Boolean @default(false)
  createdAt    DateTime @default(now())

  // True only when an admin hand-linked this punch via linkPunchesToEmployee
  // (never set by processBiometricUpload's own name matching) — lets the
  // review screen show a "Linked" history distinct from the automatic
  // matches, and lets a mistaken manual link be undone without touching
  // anything the matcher resolved on its own.
  linkedManually Boolean @default(false)

  @@index([employeeId, timestamp])
}

// A scanned name an admin has confirmed is NOT one of this office's tracked
// employees (the shared biometric machine also logs regular/permanent staff
// and other offices' COS workers — the export's own title, "Casual, COS and
// Others", says as much). Global by rawName rather than per-upload, since
// the same outside person keeps showing up under the same name in every
// future export — this is what lets the "Unmatched names" review list stop
// re-surfacing them every time.
model IgnoredBiometricName {
  id          String   @id @default(cuid())
  rawName     String   @unique
  ignoredById String
  ignoredBy   User     @relation("BiometricNameIgnorer", fields: [ignoredById], references: [id])
  ignoredAt   DateTime @default(now())
}

// ── Audit log ──────────────────────────────────────────────────
// One row per create/update/delete made through an admin (or self-service)
// action. `summary` is a human-readable line built by the action itself
// (e.g. "Marked Aug 5, 2026 as Rest Day for Juan Dela Cruz") rather than a
// generic field-level diff — cheap to write, and the only thing the
// Activity page needs to render.

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id         String      @id @default(cuid())
  entityType String
  entityId   String
  action     AuditAction
  summary    String

  actorId   String
  actor     User     @relation("AuditActor", fields: [actorId], references: [id])
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ── Notifications ─────────────────────────────────────────────
// In-app only — no email/push. Read fresh on each page load/navigation,
// same as the existing pending-DTR-requests nav badge.

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id])
  message     String
  link        String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId, read])
}
