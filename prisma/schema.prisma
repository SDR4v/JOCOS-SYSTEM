// JOCOS Attendance & Payroll System — data model
// See C:\Users\rgnac\.claude\plans\lazy-marinating-kay.md for the full design context.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Auth / roster ──────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         Role
  employeeId   String?  @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime @default(now())

  editedAttendanceDays AttendanceDay[]        @relation("AttendanceDayEditor")
  requestedLeaves      WellnessLeaveRequest[] @relation("LeaveRequester")
  cancelledLeaves      WellnessLeaveRequest[] @relation("LeaveCanceller")
  confirmedTakenLeaves WellnessLeaveRequest[] @relation("LeaveTakenConfirmer")
  enteredTripAuths     TripAuthorization[]    @relation("TripAuthEnteredBy")
  biometricUploads     BiometricUpload[]      @relation("BiometricUploader")
  reviewedDtrRequests  DtrEntryRequest[]      @relation("DtrRequestReviewer")
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

// Work schedule the DTR is graded against. STANDARD = the default 8-12 &
// 1-5 office hours, every day. CUSTOM = the employee's own hours
// (session1*, plus optional session2* — night shifts, split/irregular
// shifts, or a single continuous session with no lunch break when
// session2 is left unset), the SAME every day. PER_DAY = hours that vary
// by day of week (see EmployeeDaySchedule) — e.g. different on Monday
// than Tuesday, or off entirely on some days. Minutes are
// minutes-since-midnight (0-1439); a session may cross midnight
// (end < start).
enum ScheduleMode {
  STANDARD
  CUSTOM
  PER_DAY
}

model Employee {
  id               String         @id @default(cuid())
  employeeNo       String         @unique
  officeAssignment String
  name             String
  positionTitle    String
  salaryGrade      Int
  status           EmployeeStatus @default(ACTIVE)
  scheduleMode     ScheduleMode   @default(STANDARD)
  session1Start    Int?
  session1End      Int?
  session2Start    Int?
  session2End      Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user                  User?
  attendanceDays        AttendanceDay[]
  punchRecords          PunchRecord[]
  wellnessLeaveBalances WellnessLeaveBalance[]
  wellnessLeaveRequests WellnessLeaveRequest[]
  tripAuthorizations    TripAuthorization[]
  dtrEntryRequests      DtrEntryRequest[]
  daySchedules          EmployeeDaySchedule[]

  @@index([officeAssignment])
  @@index([status])
}

// One row per configured weekday, used only when Employee.scheduleMode
// is PER_DAY. dayOfWeek: 0 = Sunday ... 6 = Saturday. A weekday with no
// row (or with session1Start/End left null) falls back to the standard
// 8-12 & 1-5 hours for that day. session2 absent = single continuous
// session (no lunch break) for that day.
model EmployeeDaySchedule {
  id            String   @id @default(cuid())
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  dayOfWeek     Int
  session1Start Int?
  session1End   Int?
  session2Start Int?
  session2End   Int?

  @@unique([employeeId, dayOfWeek])
}

// ── Salary Grade rate table (page 1 of the source sheet) ───────

model SalaryGradeRate {
  id            String @id @default(cuid())
  year          Int
  salaryGrade   Int
  monthlyAmount Float

  @@unique([year, salaryGrade])
}

// ── DTR (Daily Time Record) ─────────────────────────────────────

enum AttendanceCode {
  PRESENT           // "0" — full day, no undertime
  LATE              // present, but late/undertime minutes logged
  ABSENT            // "A" — 0 credit
  UNDERTIME_HALF    // "U" — present AM only, 0.5 credit
  TARDY_HALF        // "T" — present PM only, 0.5 credit
  REST_DAY          // "X" — excluded, not counted, unpaid
  WORK_SUSPENDED    // "WS" — full credit, no deduction
  WELLNESS_LEAVE    // "WL" — full credit, paid, draws down WL balance
  TRIP_AUTHORIZATION // "TA" — credit computed from HR-entered time
  UNSET             // no data yet — needs manual entry or biometrics review
}

enum AttendanceSource {
  BIOMETRIC
  WELLNESS_LEAVE
  TRIP_AUTHORIZATION
  MANUAL
  EMPLOYEE_REQUEST // self-submitted by the COS worker, approved by HR
}

// A day's entry is driven by CS Form No. 48 (Daily Time Record): four punch
// times (AM/PM arrival & departure). The JOCOS code/dayCredit/lateMinutes are
// DERIVED from those times (see lib/dtr-time.ts), except for the manual
// overrides (REST_DAY, WORK_SUSPENDED, UNSET) that can't come from a punch,
// and WELLNESS_LEAVE/TRIP_AUTHORIZATION which are written by their own
// approval flows. Today the times are entered by hand; once RFID/biometric
// capture lands it fills the same four fields.
model AttendanceDay {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  date        DateTime
  code        AttendanceCode   @default(UNSET)
  lateMinutes Int              @default(0)
  dayCredit   Float            @default(0)
  source      AttendanceSource @default(MANUAL)
  amArrival   DateTime?
  amDeparture DateTime?
  pmArrival   DateTime?
  pmDeparture DateTime?
  notes       String?

  editedById String?
  editedBy   User?    @relation("AttendanceDayEditor", fields: [editedById], references: [id])
  editedAt   DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
  @@index([date])
}

// ── Employee self-submitted DTR entries (pending HR review) ────

enum DtrEntryRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model DtrEntryRequest {
  id          String                @id @default(cuid())
  employeeId  String
  employee    Employee              @relation(fields: [employeeId], references: [id])
  date        DateTime
  amArrival   DateTime?
  amDeparture DateTime?
  pmArrival   DateTime?
  pmDeparture DateTime?
  overrideCode AttendanceCode?      // set only for REST_DAY / WORK_SUSPENDED / UNSET proposals
  notes       String?
  status      DtrEntryRequestStatus @default(PENDING)
  submittedAt DateTime              @default(now())

  reviewedById String?
  reviewedBy   User?     @relation("DtrRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  @@unique([employeeId, date])
  @@index([status])
}

// ── Wellness Leave (COS only) ───────────────────────────────────

model WellnessLeaveBalance {
  id         String @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  year       Int
  semester   Int // 1 = Jan-Jun (3 days), 2 = Jul-Dec (2 days)
  allotted   Int
  used       Int @default(0)

  @@unique([employeeId, year, semester])
}

// No admin approval gate — a request takes effect immediately on filing
// (balance drawn down, attendance days marked WELLNESS_LEAVE). ACTIVE vs.
// already-taken is derived from today's date vs. endDate at display time;
// CANCELLED means the employee pulled it back out before it happened.
enum LeaveRequestStatus {
  ACTIVE
  CANCELLED
}

model WellnessLeaveRequest {
  id          String              @id @default(cuid())
  employeeId  String
  employee    Employee            @relation(fields: [employeeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  daysCount   Int
  status      LeaveRequestStatus  @default(ACTIVE)
  notes       String?

  requestedById String
  requestedBy   User   @relation("LeaveRequester", fields: [requestedById], references: [id])

  cancelledById String?
  cancelledBy   User?    @relation("LeaveCanceller", fields: [cancelledById], references: [id])
  cancelledAt   DateTime?

  // Set when an admin has physically received the employee's paper
  // application and confirms the leave was taken — locks the display
  // status to TAKEN early (ahead of endDate) and blocks a pull-out.
  confirmedTakenById String?
  confirmedTakenBy   User?     @relation("LeaveTakenConfirmer", fields: [confirmedTakenById], references: [id])
  confirmedTakenAt   DateTime?

  createdAt DateTime @default(now())
}

// ── Trip Authorization ──────────────────────────────────────────

model TripAuthorization {
  id             String   @id @default(cuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])
  date           DateTime
  timeIn         DateTime?
  timeOut        DateTime?
  referenceNo    String?
  attachmentPath String?

  enteredById String
  enteredBy   User   @relation("TripAuthEnteredBy", fields: [enteredById], references: [id])
  createdAt   DateTime @default(now())

  @@index([employeeId, date])
}

// ── Biometrics import ───────────────────────────────────────────

enum BiometricUploadStatus {
  UPLOADED
  PROCESSED
  REVIEWED
}

model BiometricUpload {
  id           String                 @id @default(cuid())
  filename     String
  periodStart  DateTime
  periodEnd    DateTime
  status       BiometricUploadStatus  @default(UPLOADED)

  uploadedById String
  uploadedBy   User   @relation("BiometricUploader", fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  punchRecords PunchRecord[]
}

model PunchRecord {
  id                String   @id @default(cuid())
  biometricUploadId String
  biometricUpload   BiometricUpload @relation(fields: [biometricUploadId], references: [id])

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id])

  rawDept      String?
  rawName      String
  rawNo        String?
  timestamp    DateTime
  isDuplicate  Boolean @default(false)
  createdAt    DateTime @default(now())

  @@index([employeeId, timestamp])
}
